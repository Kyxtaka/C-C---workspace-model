{
  "version": 3,
  "configurePresets": [
    {
      "name": "gcc-windows",
      "displayName": "GCC MinGW on Windows",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
